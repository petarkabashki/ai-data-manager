# Copy to .env and adjust. Every value here has a working default in
# utils/config.py — this file documents the knobs, it isn't required.

# --- data -------------------------------------------------------------------
# Root of the price-data tree. Default: the price-data/ symlink in the repo.
# PRICE_DATA_ROOT=/home/you/work/price-data

# Scratch root for download checkpoints and provider logs. Default: repo tmp/.
# TMP_ROOT=/home/you/work/ai-data-manager/tmp

# --- crypto (freqtrade) -----------------------------------------------------
# freqtrade executable used by tools/download_crypto.py.
# Default: ~/work/ai-quant/.venv/bin/freqtrade
# FREQTRADE_BIN=/home/you/work/ai-quant/.venv/bin/freqtrade

# --- IBKR -------------------------------------------------------------------
# TWS/IB Gateway connection. 7497 = TWS paper, 7496 = TWS live,
# 4002 = Gateway paper, 4001 = Gateway live.
# IBKR_HOST=127.0.0.1
# IBKR_PORT=7497

# Base API client id. Each tool offsets from this (index downloader uses +1,
# the retry runner +20) so two tools can share one gateway without colliding.
# IBKR_CLIENT_ID=73

# --- market cap (CoinGecko) -------------------------------------------------
# Without a pro key, historical chart requests are limited to ~365 days and
# tools/download_market_caps.py drops to a single worker.
# COINGECKO_PRO_API_KEY=

# --- price data manager (PDM) server ----------------------------------------
# Interface the server binds. Set it to the host's Tailscale IP to keep the
# service on the tailnet only. Default 0.0.0.0 (every interface).
# PDM_BIND_HOST=<host-tailscale-ip>

# Host clients connect to (Tailscale IP or MagicDNS name). Default 127.0.0.1.
# PDM_SERVER=<host-tailscale-ip>

# Request/reply and broadcast ports.
# PDM_REQ_PORT=5555
# PDM_PUB_PORT=5556
# Read-only HTTP gateway (reads, audits, refresh previews; never a token). 0 = off.
# PDM_HTTP_PORT=5580

# Shared secret for requests that change state (refresh run, submit, cancel,
# schedule_*, live_*); dry-run refreshes and reads stay open. Empty = open.
# On the server, set it here. On a client, prefer the token file below: it is
# outside the checkout, so a sandbox that can read the repo can't read it.
# PDM_TOKEN=
# PDM_TOKEN_FILE=~/.config/ai-data-manager/token   (default; mode 0600)

# Alerts (failed jobs, series that stop updating) are logged to
# tmp/pdm_alerts.jsonl and broadcast on server/alert. Set a command to also
# be notified: it gets the one-line text on stdin, the JSON in $PDM_ALERT.
# PDM_NOTIFY_CMD=curl -fsS -d @- https://ntfy.sh/<your-private-topic>
# PDM_STALE_ALERT_DAYS=2

# Schedules + live streams. Default: pdm.yaml in the repo (gitignored).
# PDM_CONFIG=/home/you/work/ai-data-manager/pdm.yaml

# --- backups (deploy/pdm-backup.sh, run on a client, pulls from the host) ---
# The rsync source. `pdm-backup:` is an ssh alias for the host's read-only
# pdm-ro account (docs/server.md, Accounts and keys). Unset: PDM_SERVER:work/price-data/
# PDM_BACKUP_SOURCE=pdm-backup:
# Where dated hard-linked snapshots go. Default: ~/backups/pdm-price-data
# PDM_BACKUP_DIR=/home/you/backups/pdm-price-data
# Keep only the newest N snapshots. Unset (default) = keep everything, prune nothing.
# PDM_BACKUP_KEEP=14
# Row-level deltas (tools/backup_delta.py export runs on the host each morning):
# take a full snapshot (a base) only every N days and pull just the deltas on
# the other nights. Unset = a full dated snapshot every night.
# PDM_BACKUP_BASE_EVERY=30
